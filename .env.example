# 1315 Panel supports two deployment modes.
# MODE A (initial): plain HTTP by public IP.
CADDY_SITE_ADDRESS=:80
PANEL_DOMAIN=
PANEL_ORIGIN=http://203.0.113.10
PUBLIC_IP=203.0.113.10
COOKIE_SECURE=false
COOKIE_DOMAIN=
# MODE B later: set CADDY_SITE_ADDRESS=panel.example.com,
# PANEL_DOMAIN=panel.example.com, PANEL_ORIGIN=https://panel.example.com,
# COOKIE_SECURE=true. Caddy will obtain and renew HTTPS automatically.

MCPANEL_UID=1000
MCPANEL_GID=1000

AUTH_ENCRYPTION_KEY=replace-with-32-random-bytes-base64url
AUTH_RECOVERY_PEPPER=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=12
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
TOTP_ISSUER=1315 Panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-random-password
COOKIE_NAME=mc_panel_session
CSRF_COOKIE_NAME=mc_panel_csrf

# Minecraft address. Initially use the VPS public IPv4; DNS is optional.
PUBLIC_HOST=203.0.113.10
DATABASE_URL=file:/app/data/mcpanel.db
SERVER_DATA_ROOT=/srv/mcpanel/servers
BACKUP_ROOT=/srv/mcpanel/legacy-backups
DOCKER_HOST=tcp://socket-proxy:2375
DOCKER_NETWORK=mcpanel-internal
MINECRAFT_IMAGE_REPOSITORY=itzg/minecraft-server
MC_BIND_ADDRESS=0.0.0.0
MC_DEFAULT_JAVA_VERSION=21
MC_DEFAULT_RESTART_POLICY=unless-stopped
MC_MANAGE_OWNERSHIP=false

# BulletServers 8 GB host profile. 6144 MB is the container ceiling and the
# default 0.92 ratio gives Java about 5.5 GiB heap, leaving host headroom.
HOST_MEMORY_MB=8192
MC_MAX_MEMORY_MB=6144
MC_HEAP_RATIO=0.92
MC_TIMEZONE=America/Chicago

MAX_UPLOAD_BYTES=67108864
MAX_TEXT_FILE_BYTES=2097152
METRICS_INTERVAL_MS=5000
METRICS_RETENTION_HOURS=24
MOD_DOWNLOAD_HOSTS=cdn.modrinth.com
MODRINTH_API_HOST=api.modrinth.com
MODRINTH_USER_AGENT=1315-panel/1.0 (self-hosted)
MODRINTH_CACHE_TTL_MS=60000
MODRINTH_CACHE_MAX_ENTRIES=500
MODRINTH_TIMEOUT_MS=10000
MODRINTH_RETRY_COUNT=3
MODRINTH_RETRY_BASE_MS=250
TRUST_PROXY=true
LOG_LEVEL=info
