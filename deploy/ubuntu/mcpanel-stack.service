[Unit]
Description=Minecraft Panel production stack
Requires=docker.service network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/mcpanel
ExecStart=/usr/bin/docker compose --env-file /opt/mcpanel/.env -f /opt/mcpanel/docker-compose.production.yml up -d --remove-orphans
ExecReload=/usr/bin/docker compose --env-file /opt/mcpanel/.env -f /opt/mcpanel/docker-compose.production.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file /opt/mcpanel/.env -f /opt/mcpanel/docker-compose.production.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
